# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# Authentication Secrets
JWT_ACCESS_SECRET=campusconnect_super_secret_jwt_access_key_2026_silicon
JWT_REFRESH_SECRET=campusconnect_super_secret_jwt_refresh_key_2026_silicon
JWT_EXPIRES_IN=7d

# Allowed University Email Domains (Comma-separated)
UNIVERSITY_EMAIL_DOMAINS=silicon.ac.in

# Cloudinary Configuration (Optional for mock/local upload mode, required for cloud production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Bootstrap
INITIAL_ADMIN_NAME=Silicon Admin
INITIAL_ADMIN_EMAIL=admin@silicon.ac.in
INITIAL_ADMIN_PASSWORD=Admin@Silicon2026

